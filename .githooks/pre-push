#!/bin/sh
# Prism L2 质量门禁 — pre-push hook
# 深度检查：完整测试

# 继承用户 PATH（含 mise/scoop shims）
case ":$PATH:" in
  *:/mnt/e/scoop/apps/mise/current/data/shims:*) ;;
  *) PATH="$PATH:/mnt/e/scoop/apps/mise/current/data/shims:/e/scoop/apps/mise/current/data/shims" ;;
esac
export PATH

# 标签推送跳过检查：推送 tag 时不运行全量测试
while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  if printf '%s' "$local_ref" | grep -q '^refs/tags/'; then
    exit 0
  fi
done

echo "=== [L2] moon info --target native ==="
moon info --target native

echo "=== [L2] moon check --warn-list +73 --deny-warn ==="
moon check --warn-list +73 --deny-warn

echo "=== [L2] moon test --target native ==="
moon test --target native

if command -v moon-audit >/dev/null 2>&1; then
  echo "=== [L2] moon-audit ==="
  if [ -n "$MOONBIT_STRICT_AUDIT" ]; then
    moon-audit --fail-on-error
  else
    moon-audit
  fi
fi

echo "=== [L2] ✅ 全部通过 ==="
