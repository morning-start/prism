pkgtype(kind: "executable")

import {
  "morning-start/prism/wasm",
  "morning-start/prism/sdk",
}

options(
  link: {
    "wasm": {
      "exports": [
        "wasm_to_lux_req",
        "wasm_lux_req_to_provider",
        "wasm_to_lux_resp",
        "wasm_lux_resp_to_provider",
        "wasm_sse_to_events",
        "wasm_events_to_sse",
        "wasm_sdk_encode_req",
        "wasm_sdk_decode_resp",
        "wasm_sdk_encode_stream",
        "wasm_sdk_decode_sse",
        "wasm_sdk_capability",
        "wasm_convert_req",
        "wasm_convert_resp",
        "wasm_convert_stream",
        "wasm_list_providers",
        "wasm_init_scratch",
        "wasm_read_scratch_arg",
        "wasm_log_init",
        "wasm_log_pos",
        "wasm_convert_req_trace",
        "wasm_convert_resp_trace",
        "wasm_convert_stream_trace",
      ],
      "export-memory-name": "memory",
    },
  },
)
