import {
  "morning-start/prism/lux",
  "morning-start/prism/sdk",
  "moonbitlang/core/json",
}

options(
  targets: {
    // memory ABI 按后端拆分（ADR-003 / RISK-006 / POC-1）：
    // - memory_linear.mbt：线性内存指针技巧（%identity 把 Int32 强转为
    //   GC 引用）仅纯 wasm 后端合法；native/llvm 同走线性内存。
    // - memory_host.mbt：宿主托管内存后端（wasm-gc / js）的降级实现，
    //   scratch/log 6 导出返回无效指针/错误信封，模块可加载。
    // 共享辅助（lookup 等）在 convert.mbt，非条件编译。
    "memory_linear.mbt": [ "wasm", "native", "llvm" ],
    "memory_host.mbt": [ "wasm-gc", "js" ],
  },
)
