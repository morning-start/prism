{
  "name": "prism-conformance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node-based conformance oracle for Prism. Validates Prism output against official provider schemas. Not part of the MoonBit build.",
  "scripts": {
    "gen-schemas": "node gen-schemas.mjs",
    "validate": "node validate.mjs",
    "check": "node run-all.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "ajv": "^8.17.1",
    "openai": "^7.43.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "ts-json-schema-generator": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
